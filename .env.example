# Copy to .env and fill in real values. Never commit .env.
# Use .env (not only .env.local): Next.js reads both, but the Prisma CLI
# (via dotenv in prisma.config.ts) reads only .env.

# Neon pooled connection (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon direct connection (no "-pooler") — used by Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Auth.js — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth client credentials (Google Cloud Console)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini-2026-03-17"
